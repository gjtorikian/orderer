POSTER_PASSWORD=your_poster_password_here
IBKR_ACCOUNT_ID=your_ibkr_account_id

IBKR_HOST=127.0.0.1
IBKR_PORT=4001
IBKR_CLIENT_ID=69420
DEBUG=ibkr*

TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

MY_NUMBER=+1234567890
TWILIO_NUMBER=+1234567890

# Trading configuration
# Set to a number for fixed spend, or "ALL" to use account's net liquidation value
MAX_SPEND=100000
# Multiplier applied to MAX_SPEND (useful for margin); default 1
MAX_SPEND_MULTIPLIER=1
WIN_PERCENTAGE=1
LOSS_PERCENTAGE=2
WIN_COUNTER_MAX=4
TRADING_MODE=PERCENTAGE
FIXED_PROFIT_AMOUNT=100
FIXED_LOSS_AMOUNT=500

# Upside-only: set to "true" to place only the profit-target limit sell and skip
# the stop loss entirely. Losing positions are never auto-sold; they hold until
# they recover to the profit target or you exit manually. Default off.
# DISABLE_STOP_LOSS=false

# SLOTS mode: allows multiple concurrent bets
# MAX_SLOTS=3
# SLOT_PROFIT_AMOUNT=100
# SLOT_LOSS_AMOUNT=200

# TRADING_MODE=MICROFLOAT (signals from the microfloat scanner): buys are placed with outsideRth
# so pre-market signals fill, and on fill sell 100% at entry x (1 + MICROFLOAT_GAIN_PERCENTAGE/100).
# MICROFLOAT_STOP_PERCENTAGE blank = no stop order; set e.g. 35 for an OCA stop at entry x 0.65.
# MICROFLOAT_GAIN_PERCENTAGE=50
# MICROFLOAT_STOP_PERCENTAGE=
